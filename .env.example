PORT=3001
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d
DB_PATH=smartfarm.sqlite
# Asal frontend yang diizinkan (pisahkan dengan koma). Kosongkan untuk mengizinkan semua.
CORS_ORIGINS=
# Saat database belum punya akun: buat admin awal ini (dipakai di produksi)...
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ...atau, bila ADMIN_* kosong, isi akun & perangkat demo
SEED_DEMO=true

# ===== Home Assistant (opsional) =====
# URL HA tanpa /api, mis. http://192.168.1.50:8123 atau https://ha.domainanda.com
HA_BASE_URL=
# Profil HA → Security → Long-lived access tokens → Create token
HA_TOKEN=
# Interval sinkronisasi sensor HA → database (detik). 0 atau HA_SYNC_ENABLED=false untuk mematikan.
HA_SYNC_INTERVAL_SEC=300
HA_SYNC_ENABLED=true
