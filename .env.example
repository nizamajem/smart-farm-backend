PORT=3001
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d
DB_PATH=smartfarm.sqlite
# Asal frontend yang diizinkan (pisahkan dengan koma). Kosongkan untuk mengizinkan semua.
CORS_ORIGINS=
# Saat database belum punya akun: buat admin awal ini (dipakai di produksi)...
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ...atau, bila ADMIN_* kosong, isi akun & perangkat demo
SEED_DEMO=true
